# =============================================================================
# BCM Application - environment configuration template
# =============================================================================
# Copy to `.env` (local dev) or `/srv/bcm/shared/.env` (production) and fill
# in real values. This file is committed; `.env` itself never is.
#
# Production-specific notes are marked [PROD]. See docs/RUNBOOK.md Section 2
# and docs/GO_LIVE_CHECKLIST.md for the full go-live sequence.
# =============================================================================

# -----------------------------------------------------------------------------
# Django core
# -----------------------------------------------------------------------------
DJANGO_ENV=production
# [PROD] >= 50 random characters. Production refuses to start otherwise.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
# [PROD] Comma-separated public host name(s), no scheme. Required, no default.
DJANGO_ALLOWED_HOSTS=
DJANGO_TIME_ZONE=Asia/Kolkata
PORT=8080

# -----------------------------------------------------------------------------
# Database - MySQL
# -----------------------------------------------------------------------------
DB_ENGINE=django.db.backends.mysql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306
DB_CONN_MAX_AGE=60
# [PROD] Path to the CA bundle if the server requires TLS; blank otherwise.
DB_SSL_CA=

# -----------------------------------------------------------------------------
# Authentication - SimpleJWT
# -----------------------------------------------------------------------------
SIMPLE_JWT_ACCESS_TOKEN_LIFETIME_SECONDS=900
SIMPLE_JWT_REFRESH_TOKEN_LIFETIME_SECONDS=86400
SIMPLE_JWT_ROTATE_REFRESH_TOKENS=True
SIMPLE_JWT_BLACKLIST_AFTER_ROTATION=True
# [PROD] Set a value distinct from DJANGO_SECRET_KEY, so rotating one does not
# invalidate every session signed with the other. Blank falls back to
# DJANGO_SECRET_KEY (fine for dev, not recommended for production).
JWT_SIGNING_KEY=

# -----------------------------------------------------------------------------
# Authentication - SSO login (Google / Microsoft Entra ID)
# -----------------------------------------------------------------------------
# NOTE: MS_ENTRA_* is the *login* app registration (authorization-code flow).
# It is a DIFFERENT registration from MS_GRAPH_* further down, which uses
# client credentials for Teams calling. Do not reuse one for the other.
# [PROD] Register this exact production redirect URI in the Google Cloud
# Console before go-live - see docs/GO_LIVE_CHECKLIST.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://YOUR-DOMAIN/auth/google/callback

MS_ENTRA_CLIENT_ID=
MS_ENTRA_CLIENT_SECRET=
MS_ENTRA_TENANT_ID=
MS_ENTRA_REDIRECT_URI=https://YOUR-DOMAIN/auth/microsoft/callback

# -----------------------------------------------------------------------------
# Authentication - OTP / password reset
# -----------------------------------------------------------------------------
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TIMEOUT=900
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
# [PROD] Ignored by production settings (REQUIRE_OTP_FOR_LOGIN is pinned True
# in code) - left here only so local/staging can turn OTP off deliberately.
REQUIRE_OTP_FOR_LOGIN=True

# -----------------------------------------------------------------------------
# Email / SMTP
# -----------------------------------------------------------------------------
# In development set EMAIL_BACKEND to the console backend to avoid sending real mail:
#   django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=
# [PROD] Comma-separated recipients for unhandled-error mail.
ADMIN_EMAILS=
# [PROD] Must be EMPTY in production - it refuses to start otherwise. Set to
# one mailbox only on a test/demo host to catch every notification there.
NOTIFICATION_REDIRECT_TO=

# -----------------------------------------------------------------------------
# Frontend / CORS / CSRF
# -----------------------------------------------------------------------------
# [PROD] The real public origins - no localhost.
FRONTEND_URL=
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
CORS_ALLOW_CREDENTIALS=True

# -----------------------------------------------------------------------------
# API behaviour
# -----------------------------------------------------------------------------
API_BASE_PATH=/api/v1
API_PAGE_SIZE=25
API_MAX_PAGE_SIZE=200
API_THROTTLE_ANON=30/min
API_THROTTLE_USER=1000/hour
API_THROTTLE_LOGIN=10/min
# [PROD] Off by default; turn on deliberately if the OpenAPI schema/Swagger UI
# must be reachable in production.
ENABLE_API_DOCS=False
# [PROD] Django admin path. Defaults to admin/ if unset; nginx also restricts
# it to the office IP range (deploy/nginx.conf) - set both together.
ADMIN_URL_PATH=admin/

# -----------------------------------------------------------------------------
# File storage (documents / Word & PDF exports)
# -----------------------------------------------------------------------------
# local | s3 | azure
STORAGE_BACKEND=local
MEDIA_URL=/media/
MEDIA_ROOT=media
# [PROD] Public origin of the BACKEND (not the frontend) - used to build
# absolute download URLs. Pointing it at the frontend 404s every download.
PUBLIC_BASE_URL=
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_EXTENSIONS=pdf,doc,docx,xls,xlsx,png,jpg,jpeg
# Required only when STORAGE_BACKEND=s3 - also the target for off-host backup
# copies (docs/GO_LIVE_CHECKLIST.md, BUG-20).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_SIGNED_URL_EXPIRY_SECONDS=600

# -----------------------------------------------------------------------------
# Call tree - voice / WhatsApp (Twilio)
# -----------------------------------------------------------------------------
# [PROD] Off by default. Turning this on is a change request with an audited
# first live run - see docs/RUNBOOK.md Section 6 "Turn on live calling".
TWILIO_ENABLED=False
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER_ID=
# [PROD] Must be a PUBLIC_BASE_URL Twilio can reach for status webhooks.
TWILIO_STATUS_CALLBACK_URL=
WHATSAPP_API_VERSION=v22.0

# -----------------------------------------------------------------------------
# Call tree - Microsoft Teams (Graph API)
# -----------------------------------------------------------------------------
TEAMS_ENABLED=False
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SCOPE=https://graph.microsoft.com/.default
TEAMS_WEBHOOK_CLIENT_STATE=

# -----------------------------------------------------------------------------
# Background jobs (Celery + Redis)
# -----------------------------------------------------------------------------
# [PROD] Must be False - production settings force it regardless, but set it
# explicitly so a local run against this file behaves the same way.
CELERY_TASK_ALWAYS_EAGER=False
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
REDIS_CACHE_URL=redis://127.0.0.1:6379/2

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
# [PROD] json in production (default); console is easier to read by eye.
LOG_FORMAT=json
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
# [PROD] The git tag/version deployed - tag Sentry events with it.
APP_VERSION=
# [PROD] Bearer token for the Prometheus scrape (GET /api/v1/metrics/).
# Unset = the endpoint does not exist. Generate: same as DJANGO_SECRET_KEY.
METRICS_TOKEN=

# -----------------------------------------------------------------------------
# Browser push (Web Push / VAPID)
# -----------------------------------------------------------------------------
# Generate once: manage.py generate_vapid_keys
# Changing the pair invalidates every existing browser subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=

# -----------------------------------------------------------------------------
# Retention (empty = keep forever; manage.py apply_retention --dry-run first)
# -----------------------------------------------------------------------------
RETENTION_AUDIT_LOG_DAYS=
RETENTION_NOTIFICATION_LOG_DAYS=
RETENTION_OTP_CHALLENGE_DAYS=
RETENTION_REPORT_OUTPUT_DAYS=
RETENTION_USER_NOTIFICATION_DAYS=
